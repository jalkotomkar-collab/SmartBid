# SmartBid secrets. Copy this file to .streamlit/secrets.toml for local use.
# (That file is git-ignored. Never commit real secrets.)
# On Streamlit Community Cloud, paste the same lines into
# Advanced settings > Secrets when you deploy, or App settings > Secrets later.

# --- Administrator account -------------------------------------------------
# Created automatically on first run if no admin exists yet.
# REQUIRED on a deployed site. Locally you may leave these out and the app
# creates a test admin (admin / Admin@12345), but only when opened at localhost.
ADMIN_USERNAME = "admin"
ADMIN_EMAIL = "you@example.com"
ADMIN_PASSWORD = "choose-a-long-unique-password"

# --- Persistent database (Turso, a hosted SQLite service) --------------------
# Leave these out to use a local SQLite file at data/auction.db.
# REQUIRED on Streamlit Community Cloud, whose disk is wiped on every restart.
# TURSO_DATABASE_URL = "libsql://your-database-your-org.turso.io"
# TURSO_AUTH_TOKEN = "paste-the-token-here"

# --- Optional ----------------------------------------------------------------
# Set to "0" to start with an empty marketplace instead of the demo listings.
# SEED_SAMPLE_DATA = "0"
